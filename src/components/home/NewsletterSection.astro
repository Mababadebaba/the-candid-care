---
---

<section class="w-full bg-[var(--color-bg-dark)] py-20">
  <div class="mx-auto max-w-[1440px] px-[var(--content-px)] flex flex-col items-center gap-8">
    <p class="font-body font-semibold text-[10px] tracking-widest uppercase text-[var(--color-accent)] leading-none">WEEKLY DISPATCH</p>
    <h2 class="font-heading font-bold text-[44px] leading-[1.3] text-[var(--color-text-light)] text-center max-w-[600px]">One email, every Sunday. No noise, just signal.</h2>
    <p class="font-body text-[16px] leading-[1.65] text-[var(--color-text-muted)] text-center max-w-[560px]">Join 12,400 readers who get our Sunday dispatch.</p>
    <div class="flex items-center h-[52px] rounded-[4px] overflow-hidden border border-[var(--color-border-muted)] bg-[#28231F]">
      <input type="email" placeholder="Your email address" required class="subscribe-input h-full w-[280px] px-5 bg-transparent text-[var(--color-text-light)] font-body text-[15px] outline-none border-none" />
      <button type="submit" class="h-full px-6 bg-[var(--color-accent)] text-[var(--color-text-light)] font-body font-semibold text-[14px] leading-none hover:opacity-90 transition-opacity rounded-[4px]">Subscribe</button>
    </div>
    <p class="font-body text-[12px] text-[var(--color-text-footer)] text-center">No spam, unsubscribe anytime.</p>
  </div>
</section>

<style>
  .subscribe-input::placeholder { color: var(--color-text-muted); opacity: 0.6; }
</style>
