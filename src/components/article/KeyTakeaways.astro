---
// KeyTakeaways.astro — 文末摘要模块（GEO 优化）

interface Props {
  takeaways: string[];
}

const { takeaways } = Astro.props;
---

{takeaways && takeaways.length > 0 && (
  <section class="max-w-[720px] mx-auto mt-16 mb-12 p-8 bg-[#F5F1ED] rounded-[4px]"
           aria-label="Key takeaways">
    <h2 class="font-heading font-bold text-[20px] text-[var(--color-text-primary)] mb-4">
      Key Takeaways
    </h2>
    <ul class="flex flex-col gap-3">
      {takeaways.map((item) => (
        <li class="flex items-start gap-3 font-body text-[15px] text-[var(--color-text-body)] leading-[1.65]">
          <span class="text-[var(--color-accent)] mt-1.5 flex-shrink-0">&bull;</span>
          <span>{item}</span>
        </li>
      ))}
    </ul>
  </section>
)}
