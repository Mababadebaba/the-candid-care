---
import { sanityClient } from "../lib/sanity";
import { HOMEPAGE_ARTICLES } from "../lib/queries";
import { generateOrganizationSchema, generateWebSiteSchema } from "../lib/schema-org";
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import HeroSection from "../components/home/HeroSection.astro";
import FeaturedBar from "../components/home/FeaturedBar.astro";
import MasonryGrid from "../components/home/MasonryGrid.astro";
import NewsletterSection from "../components/home/NewsletterSection.astro";

interface Article {
  _id: string;
  title: string;
  slug: string;
  excerpt?: string;
  heroImage?: string;
  heroImageAlt?: string;
  category?: { title: string; slug: string };
  author?: { name: string; slug: string; image?: string };
  publishedAt: string;
  tags?: string[];
}

let articles: Article[] = [];

try {
  articles = await sanityClient.fetch<Article[]>(HOMEPAGE_ARTICLES);
} catch {
  // Sanity not configured yet — fallback silently, grid shows empty state
}
---

<BaseLayout>
  <Header />
  <main class="w-full">
    <HeroSection />
    <FeaturedBar />
    <MasonryGrid articles={articles} />
    <NewsletterSection />
  </main>
  <Footer />

  <!-- Organization + WebSite JSON-LD (EEAT signal) -->
  <script type="application/ld+json" set:html={JSON.stringify(generateOrganizationSchema())}></script>
  <script type="application/ld+json" set:html={JSON.stringify(generateWebSiteSchema())}></script>
</BaseLayout>
